# Gemini API Configuration for LLM-powered pre-commit reviews & code auditor
# GOOGLE_AI_STUDIO_KEY is optional here: run `agentic-dev auth set` to store it globally, or rely on Google ADC (`gcloud auth application-default login`)
# GOOGLE_AI_STUDIO_KEY=your_google_ai_studio_key_here
GEMINI_DECISION_MODEL=gemini-decision-1
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REVIEW_MODE=decision_only
GOOGLE_CLOUD_LOCATION=global
GEMINI_TIMEOUT=30.0
GEMINI_DEP_DEPTH=1
GEMINI_MAX_DEP_CHARS=24000

# Central Organizational Rules Synchronization URL (Release bundle zip, tag URL, or repository archive)
# Reference implementation: https://github.com/buildwithdc/sample-agentic-dev-governance-rules
# ORG_RULES_SYNC_URL="https://github.com/buildwithdc/sample-agentic-dev-governance-rules/releases/latest/download/rules-org.zip"
