# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# LLM cache & temporary artifacts
.llm_cache/
.git/.llm_cache/

# Environment files
.env
.env.local
*.secret

# IDE and OS
.DS_Store
.vscode/
.idea/

# Dynamically generated assistant tooling artifacts
CLAUDE.md
.claude/
.agents/hooks.json
.agents/skills/code-auditor/
.agents/skills/personal-preferences/
# Distribution and packaging archives
dist/
*.zip

# Local audit and execution logs
.agents/*.log
*.log

# Multi-tier governance: local personal preferences (untracked) & sync timestamps
.agents/rules/personal/*
!.agents/rules/personal/.gitkeep
.agents/rules/org/.sync_timestamp
.sync_timestamp



